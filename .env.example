# Good Loop — environment
#
# Copy to ".env.local" for your machine. On Vercel these are set per
# environment in the project settings — see docs/ENVIRONMENTS.md, which is
# also where the rule lives that production keys exist in exactly one place.


# ---- Which environment is this? ---------------------------------------------
# production | staging | demo | local
#
# SET IT ON EVERY DEPLOYMENT. It is not inferred from the URL: a staging build
# opened on a preview link, a production build opened on localhost and a custom
# domain pointed at the wrong project all guess wrong, and the guess is silent.
#
# Anything other than "production" shows a banner across the top of every
# screen saying where you are and which database you are pointed at. Leaving it
# unset on a deployment that HAS a database shows a red "ENVIRONMENT NOT
# DECLARED" banner — deliberately, because the alternative is staging that
# looks exactly like the real thing.
VITE_APP_ENV=local


# ---- Database ---------------------------------------------------------------
# Leave both unset to run on the in-memory mock data (the default while
# developing). When both are present the app uses the Supabase-backed provider
# instead of the mock — no code change.
#
# ONE PROJECT PER ENVIRONMENT. Production, staging and demo are three separate
# Supabase projects, all in São Paulo. Never point staging at production.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ---- Voice (TTS) — optional --------------------------------------------------
# The Sound Studio's voice track can synthesize real guidance. Pick ONE engine.
# With none set, the Studio still PREVIEWS with the browser voice, but can't
# render/layer/export voice. See docs/TTS_SETUP.md. NOTE: these keys ship to the
# browser — fine for a closed test, proxy them server-side for production.
#
# ElevenLabs has NO env key: it is typed into the app (Dettagli → motore vocale)
# and stored in the `app_settings` table of whichever project you are on. That
# means the voice key follows the DATABASE, not the deployment — so a staging
# project needs its own key with its own spending cap, and production's must
# never be pasted into one. A build-time key was used whenever a browser had
# none saved, which spent credits on the build's account instead of the
# operator's.

# Azure neural voices (e.g. pt-BR-FranciscaNeural, pt-BR-AntonioNeural)
VITE_AZURE_TTS_KEY=
VITE_AZURE_TTS_REGION=
VITE_AZURE_TTS_VOICE=


# ---- Interface language (i18n) -----------------------------------------------
# Default UI language when the user hasn't chosen one in Profile → Language.
# One of: en | it | pt-BR   (users can always switch in-app; the choice persists
# per browser). For the Italian PO test deployment set:
VITE_DEFAULT_LOCALE=it


# ---- Emergency: turn an area off at BUILD time -------------------------------
# Normally the player, booking and the video call are switched off from the
# admin console (Interruttori), which takes effect in seconds and needs no
# deploy. This is the hatch for when the DATABASE is the thing that is broken
# and the console cannot be reached.
#
# Comma-separated, any of: player, booking, video. An area listed here cannot
# be switched back on from the console — only by removing it and redeploying.
# Leave empty in normal operation.
VITE_FEATURES_OFF=


# ---- Seeding and resetting (tools only, never in a browser build) ------------
# `npm run seed` and `npm run reset` need a key that bypasses row-level
# security. It is a SERVICE ROLE key: it can read and write everything in the
# project, so it belongs in your shell for the length of one command and
# nowhere else.
#
#   NEVER put it in .env.local — Vite inlines VITE_* into the bundle, and
#   anything else in that file still sits next to a repository that is public.
#   NEVER set it in Vercel. Nothing that runs in a browser may ever hold it.
#   NEVER use the production project's key with these tools.
#
# Pass it for a single command instead:
#   GL_SERVICE_KEY=eyJ... GL_TARGET_URL=https://xxxx.supabase.co npm run seed
