node_modules
dist
*.local
.DS_Store

# Rendered sessions are build output, not source. A 24-min master is ~250 MB —
# past GitHub's hard 100 MB per-file limit — and PO reference renders land in
# the project root while they are being analysed.
*.wav

.vercel

# TypeScript incremental build cache: a build artifact, not source
*.tsbuildinfo

# the app build output
dist-app

# iOS is not generated here (it needs a Mac). Android IS committed: it holds
# the manifest, the permissions, the app id and the icons — edits that belong
# to the product, not to one machine. Its own android/.gitignore keeps the
# build output out, and these are the per-machine bits on top of it.
ios
android/.gradle
android/local.properties
android/.idea
android/app/src/main/assets/public
android/app/src/main/assets/capacitor.config.json

# Studio session backups. THIS REPOSITORY IS PUBLIC — a saved session holds
# the protocol's voice scripts in four language variants, which is the
# material itself. Backups belong in a PRIVATE repository of their own; see
# docs/STUDIO_BACKUP.md. This line is the net under a stray `git add .`.
studio-backups/
*.glstudio.json

# Video masters. `videos/loop_login.mp4` is 78 MB of 4K at 36 Mbit — close to
# GitHub's 100 MB hard limit, and a thing every clone would carry forever for
# a file no build reads. The web encode committed under `public/media/` is
# what the app loads; the master belongs beside the other masters, outside
# this repository. docs/LOGIN_VIDEO.md has the command that makes one.
videos/
