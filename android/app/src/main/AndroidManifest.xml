<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions

         Each one is here because a shipped screen needs it. Play asks what
         sensitive permissions are for, and the honest answer has to be a
         feature somebody can point at.

         The background-audio pair is here now, because the plugin that uses
         them is: @capgo/capacitor-media-session runs a foreground service of
         type mediaPlayback for as long as a session is playing, which is the
         only thing that stops Android suspending the webview, and the audio
         with it, seconds after the screen goes dark. See docs/MOBILE.md. -->

    <!-- Reaching Supabase: the catalogue, the published audio, the account. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The therapist-led session is a real video call (src/selfuse/VideoCall.tsx).
         Requested at the moment the person joins one, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The call needs to know it has a route before it opens the room. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A session keeps playing with the screen off. The plugin's own
         manifest brings FOREGROUND_SERVICE, but from Android 14 a service
         must ALSO hold the permission matching its type — without this line
         the merged manifest looks right and the service is refused at
         runtime, which reads as "the audio just stops when I lock it". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- The camera is for the call; a device without one still gets the
         sessions, which are the product. Declared not-required so Play does
         not hide the app from those devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
